<?xml version="1.0" encoding="utf-8" ?>
<config>
  <defaults>
    <directories>
      <directory name="Fonts">Resources/Fonts</directory>
      <directory name="Textures">Resources/Textures</directory>
      <directory name="Shaders">Resources/Shaders</directory>
      <directory name="Logs">log</directory>
    </directories>
    <fonts>
      <font name="latin24pt" file="arial_sas_math_24pt" fType=".fnt" default="true"/>
      <font name="arial16" file="arial_g111_16pt" fType=".fnt" default="false"/>
    </fonts>
    <shaders>
      <shader name="color" vertShader="ColorShader.vert" fragShader="ColorShader.frag">
        <shaderAttribute name="aColor" type="color" value="vec4"/>
        <shaderAttribute name="aPosition" type="position" value="vec3"/>
      </shader>
      <shader name="text" vertShader="FontShader_default.vert" fragShader="FontShader_default.frag" defaultFor="text">
        <shaderAttribute name="aUV" type="uv" value="vec2"/>
        <shaderAttribute name="aPosition" type="position" value="vec2"/>
      </shader>
      <shader name="texture" vertShader="TextureShader.vert" fragShader="TextureShader.frag">
        <shaderAttribute name="aUV" type="uv" value="vec2"/>
        <shaderAttribute name="aPosition" type="position" value="vec3"/>
      </shader>
      <shader name="pos" vertShader="PosShader.vert" fragShader="PosShader.frag" defaultFor="color">
        <shaderAttribute name="aPosition" type="position" value="vec3"/>
      </shader>
      <shader name="pos2d" vertShader="Pos2DColor.vert" fragShader="Pos2DColor.frag" defaultFor="color2d">
        <shaderAttribute name="aPosition" type="position" value="vec2"/>
      </shader>
      <shader name="pos2dtexcolor" vertShader="Pos2DTexColor.vert" fragShader="Pos2DTexColor.frag" defaultFor="texColor2d">
        <shaderAttribute name="aPosition" type="position" value="vec2"/>
        <shaderAttribute name="aUV" type="uv" value="vec2"/>
      </shader>
    </shaders>
    <colors>
      <color name="clearColor" r="0.2" g="0.3" b="0.3" a="0.1"/>
    </colors>
  </defaults>
  <systemUI>
    <debugConsole posX="0.2%" posY="50%" width="100%" height="46%" maxLines="100" font="arial16"/>
  </systemUI>
</config>